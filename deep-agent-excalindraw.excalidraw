      "seed": 1627794191,
      "version": 160,
      "versionNonce": 960063916,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790058261593,
      "link": null,
      "locked": false,
      "text": "In this technique, the text is divided into meaningful units, such as sentences or paragraphs,\n which are then vectorized.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this technique, the text is divided into meaningful units, such as sentences or paragraphs,\n which are then vectorized.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "yHxtsW9YHJ1quft-hxg7j",
      "type": "text",
      "x": 87611.03889532192,
      "y": 12838.32119752113,
      "width": 1044.2315673828125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0g4",
      "roundness": null,
      "seed": 780275375,
      "version": 316,
      "versionNonce": 548165396,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790058261593,
      "link": null,
      "locked": false,
      "text": "This advanced technique uses a Language Model (LLM) to generate chunks. \nThe LLM processes the text and generates semantically isolated sentences \nor propositions that can stand alone. ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This advanced technique uses a Language Model (LLM) to generate chunks. \nThe LLM processes the text and generates semantically isolated sentences \nor propositions that can stand alone. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
