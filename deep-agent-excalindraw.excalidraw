      "boundElements": [],
      "updated": 1790058261594,
      "link": null,
      "locked": false,
      "text": "LangGraph lets you design multi-step,statefull,agentic workflows,\nlike finite state machines but supercharged for LLMs",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LangGraph lets you design multi-step,statefull,agentic workflows,\nlike finite state machines but supercharged for LLMs",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
