      "seed": 547357534,
      "version": 128,
      "versionNonce": 1958516140,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790058261588,
      "link": null,
      "locked": false,
      "text": "Example\n\n- when a new row is added to google sheets\n- when a new email addrives\n- when a new lead is created CRM\n- etc...",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example\n\n- when a new row is added to google sheets\n- when a new email addrives\n- when a new lead is created CRM\n- etc...",
