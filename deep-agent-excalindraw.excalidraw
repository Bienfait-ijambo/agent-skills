    {
      "id": "7mo9CF9a4hjs669LX2apU",
      "type": "text",
      "x": 66961.32600510481,
      "y": 9241.124138599218,
      "width": 788.1801079991061,
      "height": 214.62861800898813,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bo1",
      "roundness": null,
      "seed": 477046089,
      "version": 378,
      "versionNonce": 1411074732,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "DFtoMJlczg6PmrNYvJdbq",
          "type": "arrow"
        }
      ],
      "updated": 1790058261585,
      "link": null,
      "locked": false,
      "text": "Today, we’re going to build a SaaS Sales AI Agent Builder — \na powerful tool that can qualify leads automatically,\n book meetings 24/7, and engage visitors in real time. \nImagine having a smart AI working around the clock, turning casual visitors\n into loyal customers without any manual effort. By the end of this build,\n you’ll have your own AI-powered sales agent that never sleeps, \nnever misses an opportunity, and helps you scale your business\n like never before.",
      "fontSize": 21.46286180089882,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Today, we’re going to build a SaaS Sales AI Agent Builder — \na powerful tool that can qualify leads automatically,\n book meetings 24/7, and engage visitors in real time. \nImagine having a smart AI working around the clock, turning casual visitors\n into loyal customers without any manual effort. By the end of this build,\n you’ll have your own AI-powered sales agent that never sleeps, \nnever misses an opportunity, and helps you scale your business\n like never before.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
