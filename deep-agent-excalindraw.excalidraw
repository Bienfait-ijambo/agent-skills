      "text": "LangGraph, the framework for building stateful, structured AI Agents. it\nlet you design agents as graph with memory",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LangGraph, the framework for building stateful, structured AI Agents. it\nlet you design agents as graph with memory",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
