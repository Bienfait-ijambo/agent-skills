      "seed": 908509666,
      "version": 862,
      "versionNonce": 1094714004,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790058261588,
      "link": null,
      "locked": false,
      "text": "This is a no Code  AI automation workflow\n platform that let's allows you to\ncreate a Multi-Agent System ,\n Knowledgebase system ,Sales Agent Embbedable\nDirectly to your website ; you can prototype \nComplex AI Agent that has access to tools to take action \nwithout writing any line of code. With platform you can automate\n    repetitive task that takes an amount of time Finish. let's have  a \nlook to the demo",
      "fontSize": 31.93619254321784,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a no Code  AI automation workflow\n platform that let's allows you to\ncreate a Multi-Agent System ,\n Knowledgebase system ,Sales Agent Embbedable\nDirectly to your website ; you can prototype \nComplex AI Agent that has access to tools to take action \nwithout writing any line of code. With platform you can automate\n    repetitive task that takes an amount of time Finish. let's have  a \nlook to the demo",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
