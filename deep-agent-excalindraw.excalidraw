    {
      "id": "Q49c9P3VTSHmhpsJFFGRq",
      "type": "text",
      "x": 87658.72961799853,
      "y": 13630.764587381922,
      "width": 1273.747314453125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
