    {
      "id": "IwggEbx4vZ9BQW8X2p8oE",
      "type": "text",
      "x": 96492.64137697605,
      "y": 2386.431548085456,
      "width": 1092.1011962890625,
      "height": 359.2821661112007,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
