      "boundElements": [],
      "updated": 1790058261586,
      "link": null,
      "locked": false,
      "text": " RAG is a technique that enhances a model’s generation \nby retrieving the relevant information from external memory sources. \nAn external memory source can be\n an internal database, a user’s previous chat sessions, or the internet. ",
      "fontSize": 26.13768534269426,
