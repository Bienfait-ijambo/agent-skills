    {
      "id": "LrNsqTHBgy4Ut13FO5QLm",
      "type": "text",
      "x": 87748.24706772255,
      "y": 11539.697654964952,
      "width": 1092.5595703125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0fy",
      "roundness": null,
      "seed": 27601487,
      "version": 34,
      "versionNonce": 82398228,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790058261593,
      "link": null,
      "locked": false,
      "text": "This technique splits the text into chunks of a fixed size, without considering \nnatural breaks or the structure of the content. \n\nIt’s simple and cost-effective, but lacks contextual awareness.\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This technique splits the text into chunks of a fixed size, without considering \nnatural breaks or the structure of the content. \n\nIt’s simple and cost-effective, but lacks contextual awareness.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
