      "link": null,
      "locked": false,
      "text": "Every automation System starts with a Trigger is an event in\none app that starts the automation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every automation System starts with a Trigger is an event in\none app that starts the automation",
      "autoResize": true,
